# MangaLive.uz — Environment Configuration Template
# Copy this file to .env.local to configure your local development environment.
# Note: .env.local is ignored by Git and should never be committed to source control.

# ── 1. Client-Side Public Configuration (Vite) ───────────────────────────────
# Supabase API Endpoint (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous Public Key (safe for browser client with Row Level Security)
# WARNING: NEVER put your 'service_role' secret key here!
VITE_SUPABASE_ANON_KEY=

# ── 2. Server-Side Storage Configuration (Node.js ingestion scripts) ──────────
# Cloudflare R2 S3-Compatible Storage Credentials
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mangalive

# ── 3. Server-Side Publishing & Ingestion Privileges (Node.js only) ───────────
# SECURITY NOTICE:
# - NEVER prefix these variables with VITE_ (they must never be bundled into the browser client).
# - NEVER commit real secrets to source control.
#
# Option A: Server-only Supabase service-role secret key (bypasses RLS for automated CLI imports)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Option B: Authenticated Admin Account (alternative if service-role key is unavailable)
# An existing user email/password verified in public.admin_users
ADMIN_EMAIL=
ADMIN_PASSWORD=
